class Solution {
	
	public int backtrack(int idx, int[] arr, int tar, int[][] dp) {
		if (idx == 0) {
			if (arr[idx] == 0 && tar == 0) {
				return 2;
			}
			if (arr[0] == tar || tar == 0) {
				return 1;
			}
			return 0;
		}
		
		if (dp[idx][tar] != -1) {
			return dp[idx][tar];
		}
		
		int notake = backtrack(idx - 1, arr, tar, dp);
		int take = 0;
		if (arr[idx] <= tar) {
			take = backtrack(idx - 1, arr, tar - arr[idx], dp);
		}
		
		return dp[idx][tar] = (take + notake);
	}
	public int countPartitions(int[] arr, int diff) {
		// code here
		int total = 0;
		int n = arr.length;
		for (int i = 0; i<n; i++) {
			total += arr[i];
		}
		if ((total - diff)<0 || (total - diff)%2 != 0) {
			return 0;
		}
		
		int tar = (total - diff)/2;
		int[][] dp = new int[n][tar + 1];
		for (int[] row : dp) {
			Arrays.fill(row, -1);
		}
		return backtrack(n - 1, arr, tar, dp);
	}
}
