class Solution {
    public int minDifference(int nums[]) {
        // code here

                int n=nums.length;
                int sum=0;
                for(int i=0;i<n;i++){
                    sum+=nums[i];
                }
                int k=sum;
                boolean[][] dp=new boolean[n][sum+1];

                for(int i=0;i<n;i++){
                    dp[i][0]=true;
                }
                if(nums[0]<=k){
                    dp[0][nums[0]]=true;
                }

                for(int i=1;i<n;i++){
                    for(int j=1;j<=k;j++){
                        boolean notake=dp[i-1][j];
                        boolean take=false;
                        if(nums[i]<=j){
                            take=dp[i-1][j-nums[i]];
                        }
                        dp[i][j]=(take || notake);
                    }
                }
                int min=Integer.MAX_VALUE;
                for(int i=0;i<=sum/2;i++){
                    if(dp[n-1][i]==true){
                        min=Math.min(min,Math.abs((sum-i)-i));
                    }
                }

                return min;
    }
}
